# goddns crontab 配置示例
# 
# 安装方法：
# 方法 1: crontab /path/to/goddns-cron-example
# 方法 2: crontab -e 然后复制内容
#
# 查看当前 crontab: crontab -l
# 删除当前 crontab: crontab -r

# ========== 环境变量配置 ==========
# Cloudflare 配置
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_ZONE_ID=""

# 阿里云配置
ALIYUN_ACCESS_KEY_ID="LTAIyour_access_key_id_here"
ALIYUN_ACCESS_KEY_SECRET="your_access_key_secret_here"

# 全局代理（可选）
# GODDNS_PROXY="socks5://127.0.0.1:1080"

# ========== 定时任务配置 ==========

# 每 5 分钟执行一次（推荐）
*/5 * * * * /usr/local/bin/goddns run -f /etc/goddns/config.json >> /var/log/goddns-cron.log 2>&1

# 每小时执行一次
# 0 * * * * /usr/local/bin/goddns run -f /etc/goddns/config.json >> /var/log/goddns-cron.log 2>&1

# 每天执行一次
# 0 0 * * * /usr/local/bin/goddns run -f /etc/goddns/config.json >> /var/log/goddns-cron.log 2>&1

# 使用脚本方式（推荐，可加载环境变量文件）
# */5 * * * * /etc/goddns/run-goddns.sh >> /var/log/goddns-cron.log 2>&1

# ========== Crontab 时间格式说明 ==========
# ┌───────────── 分钟 (0 - 59)
# │ ┌───────────── 小时 (0 - 23)
# │ │ ┌───────────── 日期 (1 - 31)
# │ │ │ ┌───────────── 月份 (1 - 12)
# │ │ │ │ ┌───────────── 星期几 (0 - 7) (星期日=0 或 7)
# │ │ │ │ │
# * * * * * 命令

# ========== 常用时间配置示例 ==========
# */5 * * * *   - 每 5 分钟
# */10 * * * *  - 每 10 分钟
# 0 * * * *     - 每小时整点
# 0 */2 * * *   - 每 2 小时
# 0 0 * * *     - 每天午夜
# 0 0 * * 0     - 每周日凌晨
# @reboot       - 系统启动时执行
